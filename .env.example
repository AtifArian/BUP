# Copy to .env and fill in. Never commit .env (it is git- and docker-ignored).
# At least one provider key is required. Models are tried in LLM_PROVIDER_ORDER,
# each provider's primary model first, then its fallbacks.

# --- Groq (OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# --- Gemini (OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_REASONING_EFFORT=low

# --- Chain / timing ---
# Exact try-order as provider:model. Takes precedence over LLM_PROVIDER_ORDER.
LLM_MODEL_CHAIN=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,gemini:gemini-3.1-flash-lite
LLM_PROVIDER_ORDER=groq,gemini
LLM_TIMEOUT_SECONDS=10
LLM_BUDGET_SECONDS=20

# --- Server ---
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
